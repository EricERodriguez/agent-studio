{
    "name": "agent-studio-ia",
    "displayName": "Agent Studio IA",
    "description": "Visual control plane for designing and orchestrating AI agents in VS Code.",
    "version": "1.0.3",
    "publisher": "AgentstudioIA",
    "engines": {
        "vscode": "^1.110.0"
    },
    "icon": "assets/icon.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/EricERodriguez/agent-studio"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "agentStudio",
                    "title": "Agent Studio",
                    "icon": "assets/icon.png"
                }
            ]
        },
        "views": {
            "agentStudio": [
                {
                    "id": "agentStudio.onboardingView",
                    "name": "Getting Started",
                    "icon": "assets/icon.png"
                },
                {
                    "id": "agentStudio.quickActionsView",
                    "name": "Quick Actions",
                    "icon": "assets/icon.png"
                },
                {
                    "id": "agentStudio.healthView",
                    "name": "Workspace Health",
                    "icon": "assets/icon.png"
                },
                {
                    "id": "agentStudio.agentsView",
                    "name": "Agents",
                    "icon": "assets/icon.png"
                },
                {
                    "id": "agentStudio.workflowsView",
                    "name": "Workflows",
                    "icon": "assets/icon.png"
                },
                {
                    "id": "agentStudio.capabilitiesView",
                    "name": "Capabilities",
                    "icon": "assets/icon.png"
                },
                {
                    "id": "agentStudio.templatesView",
                    "name": "Templates",
                    "icon": "assets/icon.png"
                }
            ]
        },
        "commands": [
            {
                "command": "agentStudio.openDashboard",
                "title": "Agent Studio: Open Dashboard"
            },
            {
                "command": "agentStudio.quickPickAgents",
                "title": "Agent Studio: Quick Find Agent"
            },
            {
                "command": "agentStudio.quickPickWorkflows",
                "title": "Agent Studio: Quick Find Workflow"
            },
            {
                "command": "agentStudio.quickPickCapabilities",
                "title": "Agent Studio: Quick Find Capability"
            },
            {
                "command": "agentStudio.createAgent",
                "title": "Agent Studio: Create Agent"
            },
            {
                "command": "agentStudio.editAgent",
                "title": "Agent Studio: Edit Agent"
            },
            {
                "command": "agentStudio.deleteAgent",
                "title": "Agent Studio: Delete Agent"
            },
            {
                "command": "agentStudio.duplicateAgent",
                "title": "Agent Studio: Duplicate Agent"
            },
            {
                "command": "agentStudio.exportAgent",
                "title": "Agent Studio: Export Agent for Claude, Codex or Antigravity"
            },
            {
                "command": "agentStudio.openInChat",
                "title": "Agent Studio: Open Agent In Chat"
            },
            {
                "command": "agentStudio.createWorkflow",
                "title": "Agent Studio: Create Workflow"
            },
            {
                "command": "agentStudio.startMcpServer",
                "title": "Agent Studio: Start MCP Server"
            },
            {
                "command": "agentStudio.focusCapability",
                "title": "Agent Studio: Focus Capability In Dashboard"
            },
            {
                "command": "agentStudio.focusWorkflow",
                "title": "Agent Studio: Focus Workflow In Dashboard"
            },
            {
                "command": "agentStudio.refreshStudio",
                "title": "Agent Studio: Refresh Studio"
            },
            {
                "command": "agentStudio.showToolsGuide",
                "title": "Agent Studio: Show Tools Guide"
            },
            {
                "command": "agentStudio.debugShellIntegrationPrototype",
                "title": "Agent Studio: [Dev] Shell Integration Prototype (Fase 5)"
            }
        ],
        "menus": {
            "view/title": [
                {
                    "command": "agentStudio.refreshStudio",
                    "when": "view == agentStudio.quickActionsView",
                    "group": "navigation"
                },
                {
                    "command": "agentStudio.refreshStudio",
                    "when": "view == agentStudio.healthView",
                    "group": "navigation"
                },
                {
                    "command": "agentStudio.quickPickAgents",
                    "when": "view == agentStudio.agentsView",
                    "group": "navigation@2"
                },
                {
                    "command": "agentStudio.createAgent",
                    "when": "view == agentStudio.agentsView",
                    "group": "navigation"
                },
                {
                    "command": "agentStudio.quickPickWorkflows",
                    "when": "view == agentStudio.workflowsView",
                    "group": "navigation@2"
                },
                {
                    "command": "agentStudio.createWorkflow",
                    "when": "view == agentStudio.workflowsView",
                    "group": "navigation"
                },
                {
                    "command": "agentStudio.openDashboard",
                    "when": "view == agentStudio.workflowsView",
                    "group": "navigation@2"
                },
                {
                    "command": "agentStudio.showToolsGuide",
                    "when": "view == agentStudio.capabilitiesView",
                    "group": "navigation"
                },
                {
                    "command": "agentStudio.quickPickCapabilities",
                    "when": "view == agentStudio.capabilitiesView",
                    "group": "navigation@2"
                }
            ],
            "view/item/context": [
                {
                    "command": "agentStudio.editAgent",
                    "when": "view == agentStudio.agentsView && viewItem == agentStudio.agent",
                    "group": "inline"
                },
                {
                    "command": "agentStudio.openInChat",
                    "when": "view == agentStudio.agentsView && viewItem == agentStudio.agent",
                    "group": "navigation"
                },
                {
                    "command": "agentStudio.duplicateAgent",
                    "when": "view == agentStudio.agentsView && viewItem == agentStudio.agent",
                    "group": "navigation@2"
                },
                {
                    "command": "agentStudio.exportAgent",
                    "when": "view == agentStudio.agentsView && viewItem == agentStudio.agent",
                    "group": "navigation@3"
                },
                {
                    "command": "agentStudio.deleteAgent",
                    "when": "view == agentStudio.agentsView && viewItem == agentStudio.agent",
                    "group": "navigation@4"
                },
                {
                    "command": "agentStudio.startMcpServer",
                    "when": "view == agentStudio.capabilitiesView && viewItem == agentStudio.mcpServer",
                    "group": "inline"
                }
            ]
        },
        "configuration": {
            "title": "Agent Studio",
            "properties": {
                "agentStudio.agentPaths": {
                    "type": "array",
                    "default": [
                        ".github/agents"
                    ],
                    "items": {
                        "type": "string"
                    },
                    "description": "Additional workspace-relative directories to discover .agent.md files."
                },
                "agentStudio.seedSampleData": {
                    "type": "boolean",
                    "default": false,
                    "description": "When true, Agent Studio will create sample agents and a sample workflow in a new workspace. Defaults to false so no files are auto-created unless explicitly enabled."
                },
                "agentStudio.includeClaudeAgents": {
                    "type": "boolean",
                    "default": true,
                    "description": "When true, Agent Studio also discovers globally installed Claude Code subagents from ~/.claude/agents/*.md and lists them as global agents."
                },
                "agentStudio.interactionLanguage": {
                    "type": "string",
                    "enum": [
                        "en",
                        "es"
                    ],
                    "default": "en",
                    "description": "Default language for user-facing agent responses. This is independent of the Agent Studio dashboard language; individual workflow nodes can override it."
                },
                "agentStudio.cli.claudeCommand": {
                    "type": "string",
                    "default": "claude --permission-mode acceptEdits",
                    "description": "Command used to launch the Claude CLI interactively in each workflow node's terminal. Override this if you use a wrapper (e.g. a shell alias/function like 'claude-with-memory') or want different flags."
                },
                "agentStudio.cli.codexCommand": {
                    "type": "string",
                    "default": "codex --sandbox workspace-write --no-alt-screen",
                    "description": "Command used to launch the Codex CLI interactively in each workflow node's terminal. --no-alt-screen keeps Codex off the terminal's alternate screen buffer, which is more reliable for programmatically typed input. Override this if you use a wrapper or want different flags."
                },
                "agentStudio.cli.startupDelayMs": {
                    "type": "number",
                    "default": 3000,
                    "description": "Milliseconds to wait after launching a CLI in a terminal before typing the prompt into it. Increase this if your CLI (or a wrapper command) takes longer to finish starting up before it reliably accepts input."
                }
            }
        }
    },
    "scripts": {
        "build": "npm run build:extension && npm run build:webview",
        "build:extension": "esbuild src/extension.ts --bundle --platform=node --external:vscode --format=cjs --outfile=dist/extension.js",
        "watch:extension": "esbuild src/extension.ts --bundle --platform=node --external:vscode --format=cjs --outfile=dist/extension.js --watch",
        "build:webview": "vite build",
        "watch:webview": "vite build --watch",
        "dev:webview": "vite",
        "check": "tsc --noEmit",
        "lint": "eslint . --ext .ts,.tsx",
        "package:vsix": "node scripts/package-vsix.mjs",
        "package:vsix:dry": "node scripts/package-vsix.mjs --dry-run"
    },
    "dependencies": {
        "gray-matter": "^4.0.3",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "yaml": "^2.6.1",
        "zustand": "^4.5.5"
    },
    "devDependencies": {
        "@types/node": "^22.10.2",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "@types/vscode": "^1.110.0",
        "@typescript-eslint/eslint-plugin": "^8.16.0",
        "@typescript-eslint/parser": "^8.16.0",
        "@vitejs/plugin-react": "^4.3.3",
        "esbuild": "^0.24.0",
        "eslint": "^9.16.0",
        "typescript": "^5.7.2",
        "vite": "^6.0.1"
    }
}
