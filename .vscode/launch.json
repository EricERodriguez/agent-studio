{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Agent Studio (Extension Host)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "preLaunchTask": "build: extension + webview"
    }
  ]
}
